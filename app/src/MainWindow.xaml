            </Border>
          </Grid>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBox}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Firmwares" Margin="0,0,0,4" />
              <TextBlock Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4" Text="By their authors, each under its own licence (LICENSE-firmware.txt in every build)." />
              <!-- filled from the firmware list: every firmware the app offers, in the app's order -->
              <StackPanel x:Name="FirmwareCredits" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource Accent}" /><TextBlock Style="{StaticResource H2}" Text="Privacy" Margin="12,0,0,0" /></StackPanel>
                <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Text2}" Text="No account, no telemetry, no automatic updates. The app only reads the firmware list and downloads the builds you pick, over HTTPS from GitHub, and checks every download with SHA-256. eink-qemu is downloaded from GitHub only when you run your own firmware. The links on this page open in your browser." />
                <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="Your files and SD cards:" />
                <TextBlock Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" Text="%LOCALAPPDATA%\ReaderSimulator" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip="%LOCALAPPDATA%\ReaderSimulator" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Accent}" /><TextBlock Style="{StaticResource H2}" Text="Disclaimer" Margin="12,0,0,0" /></StackPanel>
                <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Text2}" Text="Unofficial: not made by, affiliated with or endorsed by Xteink. The simulator is approximate: screens, speed, battery and buttons can differ from a real reader. Official Xteink firmware cannot run here. Use it at your own risk; it comes with no warranty." />
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Grid.Column="4" Style="{StaticResource CardBox}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Also inside" Margin="0,0,0,4" />
              <TextBlock Style="{StaticResource PartHead}" Text="SIMULATOR LIBRARY" />
              <TextBlock Style="{StaticResource Body}" Margin="0,4,0,4"><Hyperlink Tag="https://github.com/uxjulia/crosspoint-simulator" Click="Link_Click">crosspoint-simulator</Hyperlink> and <Hyperlink Tag="https://github.com/uxjulia/crossink-simulator" Click="Link_Click">crossink-simulator</Hyperlink> by uxjulia</TextBlock><Border Style="{StaticResource Lic}" HorizontalAlignment="Left"><TextBlock Text="MIT" /></Border>
              <TextBlock Style="{StaticResource PartHead}" Text="GRAPHICS AND INPUT" />
              <TextBlock Style="{StaticResource Body}" Margin="0,4,0,4"><Hyperlink Tag="https://www.libsdl.org/" Click="Link_Click">SDL 2</Hyperlink></TextBlock><Border Style="{StaticResource Lic}" HorizontalAlignment="Left"><TextBlock Text="zlib" /></Border>
              <TextBlock Style="{StaticResource PartHead}" Text="SAMPLE BOOKS" />
              <TextBlock Style="{StaticResource Body}" Margin="0,4,0,4"><Italic>Pride and Prejudice</Italic>, <Italic>The Adventures of Sherlock Holmes</Italic> from <Hyperlink Tag="https://standardebooks.org/" Click="Link_Click">Standard Ebooks</Hyperlink></TextBlock><Border Style="{StaticResource Lic}" HorizontalAlignment="Left"><TextBlock Text="CC0" /></Border>
              <TextBlock Style="{StaticResource PartHead}" Text="SAMPLE DICTIONARY" />
              <TextBlock Style="{StaticResource Body}" Margin="0,4,0,4"><Hyperlink Tag="https://wordnet.princeton.edu/" Click="Link_Click">WordNet 3.0</Hyperlink>, © 2006 Princeton University</TextBlock><Border Style="{StaticResource Lic}" HorizontalAlignment="Left"><TextBlock Text="WordNet licence" /></Border>
              <TextBlock Style="{StaticResource PartHead}" Text="DEVICE FRAMES AND THIS APP" />
              <TextBlock Style="{StaticResource Body}" Text="Reader Simulator contributors" Margin="0,4,0,4" /><Border Style="{StaticResource Lic}" HorizontalAlignment="Left"><TextBlock Text="MIT" /></Border>
              <TextBlock Style="{StaticResource PartHead}" Text="YOUR OWN FIRMWARE (DOWNLOADED WHEN USED)" />
              <TextBlock Style="{StaticResource Body}" Margin="0,4,0,4"><Hyperlink Tag="https://serialx.github.io/eink-qemu/" Click="Link_Click">eink-qemu</Hyperlink> by serialx</TextBlock><Border Style="{StaticResource Lic}" HorizontalAlignment="Left"><TextBlock Text="GPL-2.0" /></Border>
              <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0">The same firmwares also run in your browser: <Hyperlink Tag="https://pewpewzxc.github.io/reader-simulator/" Click="Link_Click">the website</Hyperlink>.</TextBlock>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- Controls panel: every key and gesture, over the whole window (Controls button or F1; Esc, X or a click outside closes it) -->
    <Grid x:Name="ControlsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#99000000" MouseLeftButtonDown="ControlsOverlay_MouseDown">
      <Border x:Name="ControlsCard" Style="{StaticResource CardBox}" Margin="48,32" Padding="24" MaxWidth="1040" VerticalAlignment="Center" HorizontalAlignment="Center"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.35" /></Border.Effect>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource H1}" Text="Controls" Margin="0,0,0,4" />
              <TextBlock Style="{StaticResource Caption}" FontSize="14" Text="Use the drawn reader like the real one: press its keys, and on the X4 Pro touch its screen with the mouse." />
            </StackPanel>
            <Button x:Name="BtnCloseControls" Grid.Column="1" Style="{StaticResource IconBtn}" VerticalAlignment="Top" Margin="16,0,0,0" ToolTip="Close (Esc)" AutomationProperties.Name="Close Controls" Click="CloseControls_Click">
              <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE711;" />
            </Button>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Controls">
            <StackPanel>
            <UniformGrid Columns="3" Margin="0,0,-12,0">
              <Border Style="{StaticResource Panel}" Margin="0,0,12,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" Foreground="{DynamicResource Accent}" /><TextBlock Style="{StaticResource H2}" Text="Keys on the reader" Margin="12,0,0,0" /></StackPanel>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Click" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Press the key" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Hold" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Long press, e.g. Power to sleep" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Click while asleep" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Wake up" /></DockPanel>
                  </Border>
                  <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" Text="KEYS EACH READER HAS" Margin="0,16,0,8" />
                  <TextBlock FontWeight="SemiBold" Text="X4 Pro" Margin="0,0,0,8" />
                  <WrapPanel Margin="0,0,0,8"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Up" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Down" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Power" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Home" /></Border></WrapPanel>
                  <TextBlock FontWeight="SemiBold" Text="X4 Classic, X3" Margin="0,0,0,8" />
                  <WrapPanel><Border Style="{StaticResource KeyCap}"><TextBlock Text="Up" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Down" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Power" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Back" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Confirm" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Left" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Right" /></Border></WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Panel}" Margin="0,0,12,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C9;" Foreground="{DynamicResource Accent}" /><TextBlock Style="{StaticResource H2}" Text="Touchscreen (X4 Pro)" Margin="12,0,0,0" /></StackPanel>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Click" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Tap: open, choose" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Hold ½ s" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Select a word" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Drag left / right quickly" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Turn the page" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Drag up quickly" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Reader menu" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Drag down from the top" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Light, close menu" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Drag slowly" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Sliders, lists" /></DockPanel>
                  </Border>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Use the mouse on the reader's screen. Two-finger gestures cannot be made with one pointer." />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Panel}" Margin="0,0,12,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE765;" Foreground="{DynamicResource Accent}" /><TextBlock Style="{StaticResource H2}" Text="Keyboard" Margin="12,0,0,0" /></StackPanel>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,0,-8"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Esc" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Back" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,0,-8"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Enter" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Confirm" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,0,-8"><Border Style="{StaticResource KeyCap}"><TextBlock Text="←" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="→" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="↑" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="↓" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Arrow keys" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,0,-8"><Border Style="{StaticResource KeyCap}"><TextBlock Text="P" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Power (hold to sleep)" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,0,-8"><Border Style="{StaticResource KeyCap}"><TextBlock Text="H" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Home key" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,0,-8"><Border Style="{StaticResource KeyCap}"><TextBlock Text="S" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Sleep now" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,0,-8"><Border Style="{StaticResource KeyCap}"><TextBlock Text="PgUp" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="PgDn" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Cover buttons*" /></DockPanel>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,8">
                    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,0,-8"><Border Style="{StaticResource KeyCap}"><TextBlock Text="T" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Slide switch*" /></DockPanel>
                  </Border>
                  <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Click the simulator window first so it gets the keys. *Older simulator library only." />
                </StackPanel>
              </Border>
            </UniformGrid>
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="16,12">
              <TextBlock Style="{StaticResource Body}" Text="Try it: every new SD card has two free books and an English dictionary. On the X4 Pro with VARAGH, hold a word in a book to look it up, or turn on Settings › Reader › Tap to Look Up to look words up with a tap. In CrossInk, use Look Up Word in the reader menu." />
            </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
