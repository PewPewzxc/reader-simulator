<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ReaderSimulator</AssemblyName>
    <RootNamespace>ReaderSimulator</RootNamespace>
    <ApplicationIcon>..\ReaderSimulator.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>1.2.1</Version>
    <Product>Reader Simulator</Product>
    <AssemblyTitle>Reader Simulator</AssemblyTitle>
    <Company>Reader Simulator contributors</Company>
    <Copyright>Copyright (c) 2026 PewPewzxc and Reader Simulator contributors (MIT)</Copyright>
    <Description>Runs e-reader firmware simulators (X4 Pro, X4 Classic, X3) on Windows</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Resource Include="..\ReaderSimulator.ico" Link="ReaderSimulator.ico" />
  </ItemGroup>
  <PropertyGroup>
    <!-- the repo has device-frames/ and samples/ next to app/; the PC this was first built on has them one level up -->
    <RepoRoot Condition="Exists('..\..\device-frames')">..\..\</RepoRoot>
    <RepoRoot Condition="'$(RepoRoot)' == ''">..\..\..\</RepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(RepoRoot)device-frames\frames\*.png;$(RepoRoot)device-frames\frames\*.keys" LinkBase="frames" CopyToOutputDirectory="PreserveNewest" />
    <!-- free books and a dictionary, copied onto each new simulated SD card (Store.AddSamples) -->
    <Content Include="$(RepoRoot)samples\sd-card\**\*" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
