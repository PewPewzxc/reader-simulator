<Window x:Class="ReaderSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reader Simulator" Width="1160" Height="780" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="ReaderSimulator.ico" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="KeyCap" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="MinWidth" Value="26" />
      <Style.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
      </Style.Resources>
    </Style>
    <Style x:Key="Lic" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,0,6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Text2}" /></Style>
      </Style.Resources>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="PartHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Text2}" />
      <Setter Property="Margin" Value="0,16,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CtlResult" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text2}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
  </Window.Resources>
  <Grid x:Name="Root" Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Text}" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation -->
    <DockPanel Margin="12,24,12,16" LastChildFill="False">
      <StackPanel Orientation="Horizontal" Margin="12,0,0,24" DockPanel.Dock="Top">
        <!-- the website's reader outline, drawn so it shows in light and dark -->
        <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource Text}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M8,2.5 H16 A2,2 0 0 1 18,4.5 V19.5 A2,2 0 0 1 16,21.5 H8 A2,2 0 0 1 6,19.5 V4.5 A2,2 0 0 1 8,2.5 Z M10,18.5 H14" />
        <TextBlock Text="Reader Simulator" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <RadioButton x:Name="NavSim" AutomationProperties.Name="Simulator" DockPanel.Dock="Top" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" /><TextBlock Text="Simulator" Margin="12,0,0,0" /></StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavAbout" AutomationProperties.Name="About" DockPanel.Dock="Top" Style="{StaticResource NavItem}" Checked="Nav_Checked">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" /><TextBlock Text="About" Margin="12,0,0,0" /></StackPanel>
      </RadioButton>
      <!-- light / dark, like the Windows Settings app: System follows Windows -->
      <StackPanel DockPanel.Dock="Bottom" Margin="12,0,0,0">
        <TextBlock Style="{StaticResource Caption}" Text="Theme" Margin="0,0,0,8" />
        <UniformGrid x:Name="ThemePanel" Columns="3" Margin="0,0,-8,0" AutomationProperties.Name="Theme">
          <RadioButton Style="{StaticResource Seg}" GroupName="theme" Tag="system" AutomationProperties.Name="System theme" Checked="Theme_Checked" ToolTip="Follow Windows"><TextBlock Text="System" /></RadioButton>
          <RadioButton Style="{StaticResource Seg}" GroupName="theme" Tag="light" AutomationProperties.Name="Light theme" Checked="Theme_Checked"><TextBlock Text="Light" /></RadioButton>
          <RadioButton Style="{StaticResource Seg}" GroupName="theme" Tag="dark" AutomationProperties.Name="Dark theme" Checked="Theme_Checked"><TextBlock Text="Dark" /></RadioButton>
        </UniformGrid>
      </StackPanel>
    </DockPanel>

    <!-- Simulator page: the website's order (Device + Real size, Firmware, Battery + USB, SD card), then your own firmware -->
    <Grid x:Name="SimPage" Grid.Column="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="400" MaxWidth="620" />
        <ColumnDefinition Width="4*" />
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,24,16,12">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Simulator" />

          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Device" />
              <UniformGrid Columns="3" x:Name="DevicePanel" Margin="0,0,-8,0" />
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Real size" />
                  <TextBlock Style="{StaticResource Caption}" Text="Show the reader exactly as big as it is in your hand" TextWrapping="Wrap" />
                  <TextBlock Margin="0,4,0,0" FontSize="13"><Hyperlink Click="Measure_Click">Measure screen</Hyperlink></TextBlock>
                </StackPanel>
                <CheckBox x:Name="RealSize" Grid.Column="2" Style="{StaticResource Toggle}" Margin="16,0,0,0" VerticalAlignment="Center" Click="RealSize_Click" AutomationProperties.Name="Real size" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Firmware" />
              <ListBox x:Name="FirmwareList" Foreground="{DynamicResource Text}" ItemContainerStyle="{StaticResource Row}" Background="Transparent" BorderThickness="0"
                       MaxHeight="232" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Firmware_Changed" />
              <TextBlock x:Name="NoFeed" Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,0,0,8" />
              <TextBlock Style="{StaticResource Caption}" Text="Version" Margin="0,16,0,8" />
              <WrapPanel x:Name="VersionPanel" />
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Text2}" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,1,0,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource Caption}" FontSize="13" />
              </Grid>
              <ProgressBar x:Name="Progress" Margin="0,12,0,0" Maximum="1" Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBox}" Padding="0">
            <StackPanel>
              <Grid Margin="20,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE83F;" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Battery" />
                  <TextBlock Style="{StaticResource Caption}" Text="What the reader shows" />
                </StackPanel>
                <Slider x:Name="Battery" Grid.Column="2" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" Margin="16,0,0,0" AutomationProperties.Name="Battery"
                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10" VerticalAlignment="Center" ValueChanged="Battery_Changed" />
                <TextBlock x:Name="BatteryText" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Border Height="1" Background="{DynamicResource CardStroke}" />
              <Grid Margin="20,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="USB cable" />
                  <TextBlock Style="{StaticResource Caption}" Text="Pretend the reader is plugged in and charging" TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox x:Name="Usb" Grid.Column="2" Style="{StaticResource Toggle}" Margin="16,0,0,0" VerticalAlignment="Center" Click="Usb_Click" AutomationProperties.Name="USB cable" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="SD card" Margin="0,0,0,4" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                         Text="Each firmware version and device has its own simulated SD card. Put anything on it: books, dictionaries, fonts, plugins." />
              <!-- the card's files, as on the web page: open folders, upload, new folder, save a copy, delete -->
              <Grid x:Name="SdBox">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                  <StackPanel x:Name="SdTools" Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource IconBtn}" Margin="4,0,0,0" ToolTip="Up one folder" AutomationProperties.Name="Up one folder" Click="SdUp_Click"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74A;" /></Button>
                    <Button Style="{StaticResource IconBtn}" Margin="4,0,0,0" ToolTip="Upload files to this folder" AutomationProperties.Name="Upload files" Click="SdUpload_Click"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE898;" /></Button>
                    <Button Style="{StaticResource IconBtn}" Margin="4,0,0,0" ToolTip="Upload a folder into this folder" AutomationProperties.Name="Upload a folder" Click="SdUploadDir_Click"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8F4;" /></Button>
                    <Button Style="{StaticResource IconBtn}" Margin="4,0,0,0" ToolTip="New folder" AutomationProperties.Name="New folder" Click="SdNewDir_Click"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE710;" /></Button>
                    <Button Style="{StaticResource IconBtn}" Margin="4,0,0,0" ToolTip="Save a copy of the selected file" AutomationProperties.Name="Save a copy" Click="SdSave_Click"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74E;" /></Button>
                    <Button Style="{StaticResource IconBtn}" Margin="4,0,0,0" ToolTip="Delete the selected file or folder" AutomationProperties.Name="Delete" Click="SdDelete_Click"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74D;" /></Button>
                  </StackPanel>
                  <TextBlock x:Name="SdPath" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DockPanel>
                <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" CornerRadius="6" Padding="4">
                  <Grid>
                    <ListBox x:Name="SdList" Foreground="{DynamicResource Text}" ItemContainerStyle="{StaticResource Row}" Background="Transparent" BorderThickness="0"
                             MinHeight="56" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="SdList_DoubleClick" />
                    <TextBlock x:Name="SdEmpty" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="12,0" IsHitTestVisible="False" />
                  </Grid>
                </Border>
              </Grid>
              <!-- two even columns, so the buttons line up instead of wrapping unevenly -->
              <UniformGrid Columns="2" Margin="0,16,-8,-8">
                <Button x:Name="BtnBooks" AutomationProperties.Name="Add books" Style="{StaticResource Btn}" Margin="0,0,8,8" Click="AddBooks_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE710;" /><TextBlock Text="Add books" Margin="8,0,0,0" /></StackPanel>
                </Button>
                <Button x:Name="BtnFolder" AutomationProperties.Name="Open SD card folder" Style="{StaticResource Btn}" Margin="0,0,8,8" Click="OpenCard_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8B7;" /><TextBlock Text="Open SD card folder" Margin="8,0,0,0" /></StackPanel>
                </Button>
                <Button x:Name="BtnZip" AutomationProperties.Name="Save SD card as zip" Style="{StaticResource Btn}" Margin="0,0,8,8" Click="SdZip_Click" ToolTip="Save everything on the SD card in one .zip file">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE896;" /><TextBlock Text="Save SD card as zip" Margin="8,0,0,0" /></StackPanel>
                </Button>
                <Button x:Name="BtnFresh" AutomationProperties.Name="Fresh SD card" Style="{StaticResource Btn}" Margin="0,0,8,8" Click="FreshCard_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE72C;" /><TextBlock Text="Fresh SD card" Margin="8,0,0,0" /></StackPanel>
                </Button>
              </UniformGrid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Your own firmware" Margin="0,0,0,4" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16" TextWrapping="Wrap">
                Have a firmware .bin that is not in the list? It runs in <Hyperlink Tag="https://serialx.github.io/eink-qemu/" Click="Link_Click">eink-qemu</Hyperlink>,
                a separate free emulator by serialx that runs any firmware file unchanged. What happens:
              </TextBlock>
              <!-- what happens, step by step: it is a second program, so say so before anything is downloaded -->
              <StackPanel Margin="0,0,0,4">
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center"><Run FontWeight="SemiBold">Pick your .bin file.</Run> It runs on the device picked above.</TextBlock>
                </Grid>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center"><Run FontWeight="SemiBold">First time only:</Run> the eink-qemu app for Windows (about 15 MB) is downloaded from its GitHub page and its installer opens. It installs for you only, without administrator rights.</TextBlock>
                </Grid>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center"><Run FontWeight="SemiBold">Your firmware opens in eink-qemu's own window</Run>, not in this app, with the free books and dictionary on its SD card.</TextBlock>
                </Grid>
              </StackPanel>
              <Button x:Name="BtnOwn" AutomationProperties.Name="Run my own firmware" Style="{StaticResource Btn}" HorizontalAlignment="Left" Click="OwnFirmware_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8E5;" /><TextBlock Text="Run my own firmware…" Margin="8,0,0,0" /></StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Preview -->
      <Grid Grid.Column="1" Margin="8,24,24,24">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{DynamicResource Stage}" CornerRadius="8">
          <Viewbox Margin="32" Stretch="Uniform">
            <Grid x:Name="PreviewFrame">
              <!-- the frame's screen is see-through: show a blank e-paper page behind it -->
              <Rectangle x:Name="PreviewScreen" Fill="#F2F1EC" HorizontalAlignment="Left" VerticalAlignment="Top" />
              <Image x:Name="Preview" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
          </Viewbox>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="PreviewTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button x:Name="BtnControls" AutomationProperties.Name="Controls" Grid.Column="1" Style="{StaticResource Btn}" Margin="8,0,0,0" ToolTip="Every key and gesture (F1)" Click="Controls_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE765;" /><TextBlock Text="Controls" Margin="8,0,0,0" /></StackPanel>
            </Button>
          </Grid>
          <TextBlock x:Name="PreviewSub" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="BuildInfo" Style="{StaticResource Caption}" Margin="0,2,0,16" TextTrimming="CharacterEllipsis" />
          <Button x:Name="BtnStart" AutomationProperties.Name="Start" Style="{StaticResource AccentBtn}" Padding="20,10" FontSize="15" HorizontalAlignment="Stretch" Click="Start_Click">
            <StackPanel Orientation="Horizontal"><TextBlock x:Name="StartIcon" Style="{StaticResource Icon}" Text="&#xE768;" /><TextBlock x:Name="StartText" Text="Start" Margin="8,0,0,0" /></StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextAlignment="Center"
                     Text="The reader opens in its own window. Click its drawn keys or use the keyboard; press F1 for every key and gesture." />
          <!-- even rows that also fit the narrowest window -->
          <StackPanel x:Name="RunTools" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Caption}" Text="Screenshot" Margin="0,0,0,8" />
            <UniformGrid Columns="2" Margin="0,0,-8,0">
              <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Tag="reader" ToolTip="Save a picture of the whole reader, frame included" Click="Shot_Click">
                <TextBlock Text="Whole reader" />
              </Button>
              <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Tag="screen" ToolTip="Save only what the screen shows" Click="Shot_Click">
                <TextBlock Text="Screen only" />
              </Button>
            </UniformGrid>
          </StackPanel>
          <StackPanel x:Name="Gestures" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Caption}" Text="Touch the screen" Margin="0,0,0,8" />
            <UniformGrid Columns="5" Margin="0,0,-8,0">
              <Button Style="{StaticResource Btn}" Padding="0,6" Margin="0,0,8,0" Content="&#x2190;" Tag="left" ToolTip="Swipe left" AutomationProperties.Name="Swipe left" Click="Gesture_Click" />
              <Button Style="{StaticResource Btn}" Padding="0,6" Margin="0,0,8,0" Content="&#x2192;" Tag="right" ToolTip="Swipe right" AutomationProperties.Name="Swipe right" Click="Gesture_Click" />
              <Button Style="{StaticResource Btn}" Padding="0,6" Margin="0,0,8,0" Content="&#x2191;" Tag="up" ToolTip="Swipe up" AutomationProperties.Name="Swipe up" Click="Gesture_Click" />
              <Button Style="{StaticResource Btn}" Padding="0,6" Margin="0,0,8,0" Content="&#x2193;" Tag="down" ToolTip="Swipe down from the top" AutomationProperties.Name="Swipe down from the top" Click="Gesture_Click" />
              <Button Style="{StaticResource Btn}" Padding="0,6" Margin="0,0,8,0" Content="Hold" Tag="hold" ToolTip="Hold the middle of the screen" Click="Gesture_Click" />
            </UniformGrid>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- About page: a header with the project and its maker, then three columns -->
    <ScrollViewer x:Name="AboutPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,24,24,12">
      <StackPanel MaxWidth="1180" HorizontalAlignment="Left">
        <Border Style="{StaticResource CardBox}" Padding="24">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,32,0" VerticalAlignment="Center">
              <TextBlock Text="ABOUT" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8" />
              <TextBlock x:Name="AboutTitle" Text="Reader Simulator" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12" />
              <TextBlock Style="{StaticResource Body}" FontSize="15" Foreground="{DynamicResource Text2}" MaxWidth="560" HorizontalAlignment="Left"
                         Text="Try e-reader firmwares for the Xteink X4 Pro, X4 Classic and X3 on your PC, before you put them on a real reader. Ready-made simulator builds are downloaded from the list on GitHub the first time you use them." />
              <TextBlock x:Name="AboutStats" FontSize="14" Foreground="{DynamicResource Text2}" Margin="0,16,0,0" />
              <TextBlock Style="{StaticResource Caption}" x:Name="AboutFeed" Margin="0,8,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" CornerRadius="8" Padding="20,16" VerticalAlignment="Center">
              <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="Made by" />
                <TextBlock Text="PewPewzxc" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,-8,0">
                    <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Tag="https://github.com/PewPewzxc" AutomationProperties.Name="GitHub" Click="Link_Click" ToolTip="https://github.com/PewPewzxc">
                      <StackPanel Orientation="Horizontal"><Path Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" Fill="{DynamicResource Text}" Width="16" Height="16" Stretch="Uniform" /><TextBlock Text="GitHub" Margin="8,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Tag="https://www.linkedin.com/in/alireza-pakseresht-koubijari/" AutomationProperties.Name="LinkedIn" Click="Link_Click" ToolTip="https://www.linkedin.com/in/alireza-pakseresht-koubijari/">
