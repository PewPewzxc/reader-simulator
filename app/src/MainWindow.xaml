<Window x:Class="ReaderSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reader Simulator" Width="1160" Height="780" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="ReaderSimulator.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="KeyCap" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="MinWidth" Value="26" />
      <Style.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
      </Style.Resources>
    </Style>
    <Style x:Key="Lic" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,0,6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Text2}" /></Style>
      </Style.Resources>
    </Style>
    <Style x:Key="PartHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Text2}" />
      <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
    <Style x:Key="CtlResult" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text2}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
  </Window.Resources>
  <Grid x:Name="Root" Background="{DynamicResource Bg}" TextElement.Foreground="{DynamicResource Text}" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation -->
    <StackPanel Margin="12,18,12,12">
      <StackPanel Orientation="Horizontal" Margin="10,0,0,22">
        <Image Source="ReaderSimulator.ico" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="Reader Simulator" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <RadioButton x:Name="NavSim" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" /><TextBlock Text="Simulator" Margin="14,0,0,0" /></StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavControls" Style="{StaticResource NavItem}" Checked="Nav_Checked">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE765;" /><TextBlock Text="Controls" Margin="14,0,0,0" /></StackPanel>
      </RadioButton>
      <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Checked="Nav_Checked">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" /><TextBlock Text="About" Margin="14,0,0,0" /></StackPanel>
      </RadioButton>
    </StackPanel>

    <!-- Simulator page -->
    <Grid x:Name="SimPage" Grid.Column="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="440" MaxWidth="620" />
        <ColumnDefinition Width="4*" />
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,18,16,16">
        <StackPanel>
          <TextBlock Style="{StaticResource H1}" Text="Simulator" />

          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Device" />
              <UniformGrid Columns="3" x:Name="DevicePanel" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Firmware" />
              <ListBox x:Name="FirmwareList" Foreground="{DynamicResource Text}" ItemContainerStyle="{StaticResource Row}" Background="Transparent" BorderThickness="0"
                       MaxHeight="232" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Firmware_Changed" />
              <TextBlock x:Name="NoFeed" Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,0,0,6" />
              <TextBlock Style="{StaticResource Caption}" Text="Version" Margin="0,12,0,8" />
              <WrapPanel x:Name="VersionPanel" />
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Text2}" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,1,0,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource Caption}" FontSize="13" />
              </Grid>
              <ProgressBar x:Name="Progress" Margin="0,10,0,0" Maximum="1" Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBox}" Padding="0">
            <StackPanel>
              <Grid Margin="20,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE83F;" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Battery" />
                  <TextBlock Style="{StaticResource Caption}" Text="What the reader shows" />
                </StackPanel>
                <Slider x:Name="Battery" Grid.Column="2" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100"
                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10" VerticalAlignment="Center" ValueChanged="Battery_Changed" />
                <TextBlock x:Name="BatteryText" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Border Height="1" Background="{DynamicResource CardStroke}" />
              <Grid Margin="20,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="USB cable" />
                  <TextBlock Style="{StaticResource Caption}" Text="Pretend the reader is plugged in and charging" />
                </StackPanel>
                <CheckBox x:Name="Usb" Grid.Column="2" Style="{StaticResource Toggle}" VerticalAlignment="Center" Click="Usb_Click" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBox}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="SD card" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,-4,0,12"
                         Text="Each firmware version and device has its own simulated SD card. Put anything on it (books, dictionaries, fonts, plugins): open its folder and copy files in." />
              <WrapPanel>
                <Button x:Name="BtnBooks" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="AddBooks_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE710;" /><TextBlock Text="Add books" Margin="8,0,0,0" /></StackPanel>
                </Button>
                <Button x:Name="BtnFolder" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="OpenCard_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8B7;" /><TextBlock Text="Open SD card folder" Margin="8,0,0,0" /></StackPanel>
                </Button>
                <Button x:Name="BtnFresh" Style="{StaticResource Btn}" Click="FreshCard_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE72C;" /><TextBlock Text="Fresh SD card" Margin="8,0,0,0" /></StackPanel>
                </Button>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Preview -->
      <Grid Grid.Column="1" Margin="8,18,24,20">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{DynamicResource Stage}" CornerRadius="12">
          <Viewbox Margin="36" Stretch="Uniform">
            <Grid x:Name="PreviewFrame">
              <!-- the frame's screen is see-through: show a blank e-paper page behind it -->
              <Rectangle x:Name="PreviewScreen" Fill="#F2F1EC" HorizontalAlignment="Left" VerticalAlignment="Top" />
              <Image x:Name="Preview" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
          </Viewbox>
        </Border>
        <StackPanel Grid.Row="1" Margin="4,16,4,0">
          <TextBlock x:Name="PreviewTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PreviewSub" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,14" TextTrimming="CharacterEllipsis" />
          <Button x:Name="BtnStart" Style="{StaticResource AccentBtn}" Padding="20,11" FontSize="15" HorizontalAlignment="Stretch" Click="Start_Click">
            <StackPanel Orientation="Horizontal"><TextBlock x:Name="StartIcon" Style="{StaticResource Icon}" Text="&#xE768;" /><TextBlock x:Name="StartText" Text="Start" Margin="10,0,0,0" /></StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextAlignment="Center"
                     Text="In the simulator: click the drawn keys, or use Esc, Enter and the arrow keys. Every key and gesture: Controls." />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Controls page: every key and gesture of the simulator -->
    <ScrollViewer x:Name="ControlsPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,18,24,16">
      <StackPanel MaxWidth="1180" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Controls" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource Caption}" FontSize="14" Margin="0,0,0,18" Text="Use the drawn reader like the real one: press its keys, and on the X4 Pro touch its screen with the mouse." />
        <UniformGrid Columns="3">
          <Border Style="{StaticResource CardBox}" Margin="0,0,12,12" VerticalAlignment="Stretch">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" Foreground="{DynamicResource Accent}" /><TextBlock Style="{StaticResource H2}" Text="Keys on the reader" Margin="10,0,0,0" /></StackPanel>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Click" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Press the key" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Hold" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Long press, e.g. Power to sleep" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Click while asleep" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Wake up" /></DockPanel>
              </Border>
              <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" Text="KEYS EACH READER HAS" Margin="0,16,0,8" />
              <TextBlock FontWeight="SemiBold" Text="X4 Pro" Margin="0,0,0,6" />
              <WrapPanel Margin="0,0,0,10"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Up" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Down" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Power" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Home" /></Border></WrapPanel>
              <TextBlock FontWeight="SemiBold" Text="X4 Classic, X3" Margin="0,0,0,6" />
              <WrapPanel><Border Style="{StaticResource KeyCap}"><TextBlock Text="Up" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Down" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Power" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Back" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Confirm" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Left" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="Right" /></Border></WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBox}" Margin="0,0,12,12" VerticalAlignment="Stretch">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C9;" Foreground="{DynamicResource Accent}" /><TextBlock Style="{StaticResource H2}" Text="Touchscreen (X4 Pro)" Margin="10,0,0,0" /></StackPanel>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Click" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Tap: open, choose" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Hold ½ s" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Select a word" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Drag left / right quickly" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Turn the page" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Drag up quickly" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Reader menu" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Drag down from the top" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Light, close menu" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock FontWeight="SemiBold" Text="Drag slowly" /></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Sliders, lists" /></DockPanel>
              </Border>
              <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="Use the mouse on the reader's screen. Two-finger gestures cannot be made with one pointer." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBox}" Margin="0,0,12,12" VerticalAlignment="Stretch">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE765;" Foreground="{DynamicResource Accent}" /><TextBlock Style="{StaticResource H2}" Text="Keyboard" Margin="10,0,0,0" /></StackPanel>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Esc" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Back" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Enter" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Confirm" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Style="{StaticResource KeyCap}"><TextBlock Text="←" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="→" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="↑" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="↓" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Arrow keys" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Style="{StaticResource KeyCap}"><TextBlock Text="P" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Power (hold to sleep)" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Style="{StaticResource KeyCap}"><TextBlock Text="H" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Home key" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Style="{StaticResource KeyCap}"><TextBlock Text="S" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Sleep now" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Style="{StaticResource KeyCap}"><TextBlock Text="PgUp" /></Border><Border Style="{StaticResource KeyCap}"><TextBlock Text="PgDn" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Cover buttons*" /></DockPanel>
              </Border>
              <Border BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="0,9">
                <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Border Style="{StaticResource KeyCap}"><TextBlock Text="T" /></Border></StackPanel><TextBlock Style="{StaticResource CtlResult}" Text="Slide switch*" /></DockPanel>
              </Border>
              <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="Click the simulator window first so it gets the keys. *Older simulator library only." />
            </StackPanel>
          </Border>
        </UniformGrid>
        <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">
          <TextBlock Style="{StaticResource Body}" Text="Try it: every new SD card has two free books and an English dictionary. On the X4 Pro with VARAGH, hold a word in a book to look it up, or turn on Settings › Reader › Tap to Look Up to look words up with a tap. In CrossInk, use Look Up Word in the reader menu." />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- About page: a header with the project and its maker, then three columns -->
    <ScrollViewer x:Name="AboutPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,18,24,16">
      <StackPanel MaxWidth="1180" HorizontalAlignment="Left">
        <Border Style="{StaticResource CardBox}" Padding="28,24">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,32,0" VerticalAlignment="Center">
              <TextBlock Text="ABOUT" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,6" />
              <TextBlock x:Name="AboutTitle" Text="Reader Simulator" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,10" />
              <TextBlock Style="{StaticResource Body}" FontSize="15" Foreground="{DynamicResource Text2}" MaxWidth="560" HorizontalAlignment="Left"
                         Text="Try e-reader firmwares for the Xteink X4 Pro, X4 Classic and X3 on your PC, before you put them on a real reader. Ready-made simulator builds are downloaded from the list on GitHub the first time you use them." />
              <TextBlock Style="{StaticResource Caption}" x:Name="AboutFeed" Margin="0,12,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" CornerRadius="10" Padding="18,16" VerticalAlignment="Center">
              <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="Made by" />
                <TextBlock Text="PewPewzxc" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Tag="https://github.com/PewPewzxc" Click="Link_Click" ToolTip="https://github.com/PewPewzxc">
                      <StackPanel Orientation="Horizontal"><Path Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" Fill="{DynamicResource Text}" Width="16" Height="16" Stretch="Uniform" /><TextBlock Text="GitHub" Margin="8,0,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Tag="https://www.linkedin.com/in/alireza-pakseresht-koubijari/" Click="Link_Click" ToolTip="https://www.linkedin.com/in/alireza-pakseresht-koubijari/">
                      <StackPanel Orientation="Horizontal"><Path Data="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" Fill="{DynamicResource Text}" Width="16" Height="16" Stretch="Uniform" /><TextBlock Text="LinkedIn" Margin="8,0,0,0" /></StackPanel>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource Btn}" Margin="0,10,0,0" HorizontalAlignment="Left" Tag="https://github.com/PewPewzxc/reader-simulator" Click="Link_Click" Content="Source code on GitHub  &#x2192;" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardBox}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Firmwares" Margin="0,0,0,2" />
              <TextBlock Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4" Text="By their authors, each under its own licence (LICENSE-firmware.txt in every build)." />
              <!-- filled from the firmware list: every firmware the app offers, in the app's order -->
              <StackPanel x:Name="FirmwareCredits" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource Accent}" /><TextBlock Style="{StaticResource H2}" Text="Privacy" Margin="10,0,0,0" /></StackPanel>
